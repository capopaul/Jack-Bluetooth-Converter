  <diagram id="3l1M0Kb5IK_8cgUmtYEK" name="SINK  |  Bluetooth → Jack">
    <mxGraphModel dx="3178" dy="1725" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-1" value="SINK  |  Bluetooth → Jack" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="20" width="1530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-2" value="Your phone sends SBC audio. The ESP32 decodes it to PCM, sends PCM over I2S, and the external audio codec produces the analog output." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="90" width="1530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-3" value="Read numbered startup steps top → bottom. Then follow the green audio arrows left → right.&#xa;P = task priority. Callback = a function called inside an existing task; it does not create a task or execute as a GPIO interrupt.&#xa;Purple dashed arrows: event enables the marked startup transition. Green dashed arrows labeled creates: startup creates the task." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="1790" width="1530" height="105" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-4" value="A. STARTUP — happens once" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="185" width="750" height="45" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-5" value="1. app_main has already selected B2J&#xa;I2S TX installed: create ring buffer (64 KiB), binary semaphore,&#xa;tx_mutex and i2s_tx_task (P22). Configure DAC / headphones." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="64.88999999999999" y="245" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-6" value="2. app_main calls bt_app_a2dp_sink_start()&#xa;sbc_sink_init() creates decoder_mutex + packet_queue (24 entries),&#xa;opens SBC decoder and creates sbc_decode task (P5)." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="64.88999999999999" y="410" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-7" value="3. sink_start queues a setup message to BtAppTask, then returns&#xa;BtAppTask runs register_a2dp_sink_callback_function(): register&#xa;control callback + audio callback, then request A2DP sink init." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="64.88999999999999" y="575" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-8" value="4. Bluetooth reports INIT_SUCCESS → register SBC endpoint&#xa;Endpoint registration succeeds → device becomes discoverable.&#xa;Phone connects and negotiates SBC, 44.1 kHz stereo." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="64.88999999999999" y="740" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-9" value="5. AUDIO_CFG + AUDIO_STARTED enable playback&#xa;BtAppTask calls sbc_sink_set_playing(true) only for valid config.&#xa;It resets decoder / queued audio and marks the stream active." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="64.88999999999999" y="905" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-10" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-5" target="P3cnZn7GwaPvSq8VvVxR-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-11" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-6" target="P3cnZn7GwaPvSq8VvVxR-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-12" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-7" target="P3cnZn7GwaPvSq8VvVxR-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-13" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-8" target="P3cnZn7GwaPvSq8VvVxR-37">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-14" value="HOW CONTROL EVENTS REACH YOUR CODE" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="844.89" y="185" width="715" height="45" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-15" value="BTC_TASK — Bluetooth event arrives&#xa;SDK calls bt_app_a2dp_cb(event, params).&#xa;That function copies event parameters and calls&#xa;bt_app_work_dispatch(handle_a2dp_event, ...).&#xa;Then the callback returns." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="874.89" y="245" width="655" height="195" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-16" value="P 19" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1439.8899999999999" y="252" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-17" value="s_bt_app_task_queue — 10 messages&#xa;Carries control events and setup requests, NOT audio packets." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#d5e8d4;strokeColor=#619766;" vertex="1" parent="1">
          <mxGeometry x="874.89" y="500" width="655" height="95" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-18" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-15" target="P3cnZn7GwaPvSq8VvVxR-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-19" value="BtAppTask — repeating loop&#xa;WAIT: xQueueReceive(..., portMAX_DELAY)&#xa;→ execute msg.cb(event, params)&#xa;→ free message parameters&#xa;→ return to WAIT.&#xa;Sink events execute handle_a2dp_event()." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="874.89" y="655" width="655" height="245" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-20" value="P 10" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1439.8899999999999" y="662" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-21" value="wake" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-17" target="P3cnZn7GwaPvSq8VvVxR-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-22" value="wait for next message" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-19" target="P3cnZn7GwaPvSq8VvVxR-17">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1544.8899999999999" y="950" />
              <mxPoint x="1544.8899999999999" y="545" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-23" value="B. AUDIO — repeats continuously after playback starts" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="1110" width="1530" height="50" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-24" value="BTC_TASK (already running before sink_start)&#xa;Phone → SDK audio receive queue&#xa;→ sbc_sink_receive(buffer)&#xa;&#xa;If playing: enqueue buffer pointer + generation.&#xa;If inactive / invalid / queue full: free buffer.&#xa;Callback returns to Bluetooth." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="1205" width="430" height="290" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-25" value="P 19" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="369.89" y="1212" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-26" value="sbc_decode&#xa;WAIT for packet_queue&#xa;→ take decoder_mutex&#xa;→ discard stale generation OR decode SBC frames&#xa;→ validate PCM16 stereo / 44.1 kHz&#xa;→ write PCM to ring under tx_mutex&#xa;→ release mutex; free input buffer&#xa;→ repeat WAIT." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="579.89" y="1205" width="430" height="290" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-27" value="P 5" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="919.89" y="1212" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-28" value="i2s_tx_task&#xa;WAIT for binary semaphore&#xa;→ take tx_mutex; read ring chunk&#xa;→ convert PCM16 to 32-bit I2S words&#xa;→ write I2S; return ring item; unlock&#xa;→ repeat chunks until ring empty&#xa;→ return to semaphore WAIT.&#xa;External DAC → headphones / Jack." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1129.8899999999999" y="1205" width="430" height="290" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-29" value="P 22" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1469.8899999999999" y="1212" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-30" value="packet_queue&#xa;24 packets" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-24" target="P3cnZn7GwaPvSq8VvVxR-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-31" value="PCM ring&#xa;64 KiB" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-26" target="P3cnZn7GwaPvSq8VvVxR-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-32" value="Ring wakeup: at 48 KiB buffered, producer gives semaphore. Underflow → prefetch again. Ring overflow → drop incoming PCM.&#xa;The decoder loops over all SBC frames in each packet. TX loops over chunks until empty; DMA writes may block while holding tx_mutex.&#xa;Suspend / disconnect: BtAppTask calls sbc_sink_set_playing(false), invalidates old packets, resets decoder and flushes TX. Tasks remain allocated." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="29.889999999999986" y="1570" width="1530" height="155" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-33" value="" style="ellipse;fillColor=#8a4ea8;strokeColor=#8a4ea8;" vertex="1" parent="1">
          <mxGeometry x="404.89" y="547" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-34" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-33" target="P3cnZn7GwaPvSq8VvVxR-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-35" value="" style="ellipse;fillColor=#8a4ea8;strokeColor=#8a4ea8;" vertex="1" parent="1">
          <mxGeometry x="404.89" y="712" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-36" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-35" target="P3cnZn7GwaPvSq8VvVxR-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-37" value="" style="ellipse;fillColor=#8a4ea8;strokeColor=#8a4ea8;" vertex="1" parent="1">
          <mxGeometry x="404.89" y="877" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-38" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-37" target="P3cnZn7GwaPvSq8VvVxR-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-39" value="Setup message dequeued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#8a4ea8;dashed=1;exitX=0;exitY=0.1;entryX=1;entryY=0.5;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-19" target="P3cnZn7GwaPvSq8VvVxR-33">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="809.89" y="680" />
              <mxPoint x="809.89" y="552" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-40" value="INIT_SUCCESS → handle_a2dp_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#8a4ea8;dashed=1;exitX=0;exitY=0.4;entryX=1;entryY=0.5;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-19" target="P3cnZn7GwaPvSq8VvVxR-35">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="799.89" y="750" />
              <mxPoint x="799.89" y="717" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-41" value="AUDIO_CFG + AUDIO_STARTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#8a4ea8;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-19" target="P3cnZn7GwaPvSq8VvVxR-37">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="789.89" y="850" />
              <mxPoint x="789.89" y="882" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-42" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#177d57;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-5" target="P3cnZn7GwaPvSq8VvVxR-28">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9.889999999999986" y="305" />
              <mxPoint x="9.889999999999986" y="1060" />
              <mxPoint x="1579.8899999999999" y="1060" />
              <mxPoint x="1579.8899999999999" y="1180" />
              <mxPoint x="1344.8899999999999" y="1180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="P3cnZn7GwaPvSq8VvVxR-43" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#177d57;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="P3cnZn7GwaPvSq8VvVxR-6" target="P3cnZn7GwaPvSq8VvVxR-26">
          <mxGeometry relative="1" as="geometry">
