        <mxCell id="4QvmPS0hkcfipZOBQ_3p-64" value="&lt;span style=&quot;font-size: 13px;&quot;&gt;packet_queue&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;24 packets&lt;/span&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="gwNP__IbfEE1y5LRwmED-64">
          <mxGeometry x="-0.1955" y="6" relative="1" as="geometry">
