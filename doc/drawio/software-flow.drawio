          </mxGeometry>
        </mxCell>
        <mxCell id="y9zUSz1hiGl54kKNKP2l-64" value="&lt;span style=&quot;font-size: 13px;&quot;&gt;PCM ring&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;64 KiB&lt;/span&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="gwNP__IbfEE1y5LRwmED-65">
