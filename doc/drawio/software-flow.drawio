          <mxGeometry x="400" y="8" width="88" height="32" as="geometry" />
        </mxCell>
        <mxCell id="45" value="4096 B stack&#xa;Wait for packet queue → SBC decode → PCM ring&#xa;Created inside sbc_sink_init(), before queued BT setup" style="rounded=1;whiteSpace=wrap;html=0;fontSize=15;spacing=10;fillColor=#e8effa;strokeColor=#6484ac;" parent="6rSli4vtfrA97XrJgapH-73" vertex="1">
