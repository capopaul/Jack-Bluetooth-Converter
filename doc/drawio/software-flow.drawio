  <diagram id="ug1pgtTAvfxsrM9GMxKT" name="SOURCE  |  Jack → Bluetooth">
    <mxGraphModel dx="2431" dy="1319" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-1" value="SOURCE  |  Jack → Bluetooth" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="30" width="1530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-2" value="The external codec samples the Jack input. The ESP32 captures PCM over I2S, encodes AAC and sends it to the Bluetooth receiver." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="1530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-3" value="Read numbered startup steps top → bottom. Then follow the green audio arrows left → right.&#xa;P = task priority. Callback = a function called inside an existing task; it does not create a task or execute as a GPIO interrupt.&#xa;Purple dashed arrows: event enables the marked startup transition. Green dashed arrows labeled creates: startup creates the task." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="380" y="1800" width="1530" height="105" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-4" value="A. STARTUP — then wait for connection" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="195" width="750" height="45" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-5" value="1. app_main has already selected J2B&#xa;Install I2S RX: create pcm_stream (8192 bytes) and i2s_rx_task (P5).&#xa;Configure the ADC; capture starts before Bluetooth streaming." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="415" y="255" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-6" value="2. app_main calls bt_app_a2dp_source_start()&#xa;It queues source setup to BtAppTask, then returns.&#xa;No AAC worker is created by this call." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="415" y="420" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-7" value="3. BtAppTask runs the source setup callback&#xa;Initialize AVRCP controller + A2DP source; register callbacks.&#xa;Start discovery and repeating 10-second connTmr." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="415" y="585" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-8" value="4. GAP callback finds matching target name / rendering device&#xa;Cancel discovery → on discovery stopped, connect to target.&#xa;A2DP callbacks report connection / negotiated AAC configuration." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="415" y="750" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-9" value="5. Connected: heartbeat requests CHECK_SRC_RDY&#xa;Successful ACK → request START. Successful START ACK + AAC&#xa;configuration → encode_task_launch() creates a2dp_aac (P10)." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="415" y="915" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-10" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-5" target="A0Lk1Ms2tbRdlZo5ghbr-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-11" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-6" target="A0Lk1Ms2tbRdlZo5ghbr-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-12" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-7" target="A0Lk1Ms2tbRdlZo5ghbr-34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-13" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-8" target="A0Lk1Ms2tbRdlZo5ghbr-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-14" value="EVENTS THAT DRIVE STARTUP" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1195" y="195" width="715" height="45" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-15" value="BTC_TASK&#xa;A2DP: bt_app_a2d_cb → queue connection / media events.&#xa;INIT_SUCCESS also registers AAC + SBC endpoints.&#xa;AVRCP: bt_app_rc_ct_cb → queue supported events.&#xa;GAP: bt_app_gap_cb handles discovery / connect directly.&#xa;Callbacks return to the SDK; none creates a task per event." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1225" y="255" width="655" height="230" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-16" value="P 19" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1790" y="262" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-17" value="FreeRTOS timer-service task&#xa;Every 10 s: call bt_app_a2d_heart_beat()&#xa;→ enqueue heartbeat event → return.&#xa;connTmr is a timer object, NOT a new task." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1225" y="525" width="655" height="175" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-18" value="P 1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1790" y="532" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-19" value="BtAppTask&#xa;WAIT on shared 10-message control queue&#xa;→ run state-machine / AVRCP handler&#xa;→ free copied parameters → repeat WAIT.&#xa;The connection / media state machine sends requests&#xa;and waits for later ACK events; it does not spin-wait." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1225" y="770" width="655" height="230" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-20" value="P 10" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1790" y="777" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-21" value="queued A2DP / AVRCP events" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-15" target="A0Lk1Ms2tbRdlZo5ghbr-19">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1185" y="370" />
              <mxPoint x="1185" y="885" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-22" value="queued heartbeat" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-17" target="A0Lk1Ms2tbRdlZo5ghbr-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-23" value="B. AUDIO — repeats while a2dp_aac is running" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#243954;strokeColor=#243954;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="1120" width="1530" height="50" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-24" value="i2s_rx_task&#xa;External ADC → I2S DMA&#xa;WAIT: i2s_channel_read (up to 1000 ms)&#xa;→ extract upper 16 bits, retain L/R ordering&#xa;→ if space exists, write complete PCM chunk&#xa;→ repeat read.&#xa;Full stream: discard captured chunk." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="380" y="1215" width="430" height="290" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-25" value="P 5" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="720" y="1222" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-26" value="a2dp_aac&#xa;WAIT: read pcm_stream (100 ms at a time)&#xa;→ keep reading until one PCM frame is full&#xa;→ esp_audio_enc_process()&#xa;→ verify encoded length ≤ MTU − 20&#xa;→ allocate / copy A2DP audio buffer&#xa;→ send; retry up to 10 times&#xa;→ repeat while s_stream_run." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#e8ddf4;strokeColor=#9673a6;spacingTop=42;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="930" y="1215" width="430" height="290" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-27" value="P 10" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#f3f6fa;strokeColor=#93a4b8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1222" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-28" value="A2DP transport → remote receiver&#xa;&#xa;esp_a2d_source_audio_data_send()&#xa;Success: stack owns the audio buffer;&#xa;AAC task advances timestamp.&#xa;Failure: task frees buffer.&#xa;Remote device decodes and plays audio.&#xa;This box is transport, not a new application task." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#d5e8d4;strokeColor=#619766;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1215" width="430" height="290" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-29" value="pcm_stream&#xa;8192 bytes" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-24" target="A0Lk1Ms2tbRdlZo5ghbr-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-30" value="encoded AAC" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-26" target="A0Lk1Ms2tbRdlZo5ghbr-28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-31" value="Oversized / failed encode: drop frame and continue. Queue busy: delay 2 ms converted to ticks before retry; invalid state exits worker.&#xa;encode_task_stop(): set run=false; worker normally leaves loop, frees buffers, closes encoder and deletes itself. After 3 s, caller force-deletes it.&#xa;Source advertises SBC too, but this application only launches its encoder when an AAC configuration exists. No SBC source encoder is implemented here." style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="1580" width="1530" height="155" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-32" value="" style="ellipse;fillColor=#8a4ea8;strokeColor=#8a4ea8;" vertex="1" parent="1">
          <mxGeometry x="755" y="557" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-33" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-32" target="A0Lk1Ms2tbRdlZo5ghbr-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-34" value="" style="ellipse;fillColor=#8a4ea8;strokeColor=#8a4ea8;" vertex="1" parent="1">
          <mxGeometry x="755" y="722" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-35" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A0Lk1Ms2tbRdlZo5ghbr-34" target="A0Lk1Ms2tbRdlZo5ghbr-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="A0Lk1Ms2tbRdlZo5ghbr-36" value="" style="ellipse;fillColor=#8a4ea8;strokeColor=#8a4ea8;" vertex="1" parent="1">
