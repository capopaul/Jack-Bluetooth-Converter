        <mxCell id="9" value="interrupt_task • 3072 B" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;spacing=2;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="590" y="166" width="530" height="36" as="geometry" />
