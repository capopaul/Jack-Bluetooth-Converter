            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="45" value="registers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;dashed=1;strokeColor=#4477bb;" parent="1" source="14" target="27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="46" value="No separate task is created per callback.&#xa;A2DP / AVRCP handlers queued to BtAppTask&#xa;run serially with all other application messages.&#xa;GAP state writes also occur in BTC_TASK." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#c9a33b;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="45" y="830" width="430" height="175" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="5" name="5 | Source audio: capture and encoder loops">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1450" pageScale="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="5 | Source audio: capture and encoder loops&#xa;J2B steady state. I2S RX exists before source_start; AAC worker is conditional. Behavior reflects jack2bluetooth, not the separate esp32_j2b project." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
