        <mxCell id="8" value="P 10" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;fontStyle=1;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1205" y="128" width="85" height="32" as="geometry" />
