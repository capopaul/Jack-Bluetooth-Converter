          <mxGeometry x="35" y="166" width="390" height="36" as="geometry" />
        </mxCell>
        <mxCell id="7" value="io_expander_irq" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;verticalAlign=top;align=left;fontStyle=1;spacingTop=14;fillColor=#faf8fc;" parent="1" vertex="1">
