        <mxCell id="42" value="shared stop flag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;dashed=1;strokeColor=#4477bb;" edge="1" parent="1" source="41" target="27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Worker never waits on the task notification; its PCM read timeout lets it observe run=false.&#xa;Initial encoder-open failure deletes the task without clearing the saved task handle.&#xa;Forced deletion can bypass normal heap / encoder cleanup. RX currently has no implemented stop loop." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=9;" vertex="1" parent="1">
