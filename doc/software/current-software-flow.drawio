              <mxPoint x="735" y="625" />
              <mxPoint x="735" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="40" value="esp_a2d_source_audio_data_send()&#xa;ESP_OK consumes buffer&#xa;Queue full: delay 2 ms ticks, retry&#xa;INVALID_ARG / SIZE / STATE:&#xa;return immediately" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#619766;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="1470" y="690" width="270" height="175" as="geometry" />
        </mxCell>
        <mxCell id="41" value="encode_task_stop() [caller]&#xa;Set run=false; notify worker&#xa;Poll handle up to 3 seconds&#xa;Timeout → force-delete task" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="1470" y="975" width="270" height="160" as="geometry" />
