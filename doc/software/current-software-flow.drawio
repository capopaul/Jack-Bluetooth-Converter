        <mxCell id="23" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="17" target="14">
          <mxGeometry relative="1" as="geometry">
