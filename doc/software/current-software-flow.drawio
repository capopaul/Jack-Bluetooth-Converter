        <mxCell id="2" value="6 | Interrupts, callbacks and current shutdown&#xa;Only the GPIO handler is an application hardware ISR. Registered BT callbacks and timer callbacks run in task context." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="25" y="15" width="1740" height="85" as="geometry" />
