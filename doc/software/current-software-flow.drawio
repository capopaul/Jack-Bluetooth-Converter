        <mxCell id="7" value="a2dp_aac" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;verticalAlign=top;align=left;fontStyle=1;spacingTop=14;fillColor=#faf8fc;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="580" height="1160" as="geometry" />
