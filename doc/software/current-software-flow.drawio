        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" parent="1" source="20" target="21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" value="task notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" parent="1" source="15" target="18" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="26" value="LOW" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" parent="1" source="21" target="19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="875" />
              <mxPoint x="1110" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="27" value="HIGH" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" parent="1" source="21" target="18" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="875" />
              <mxPoint x="590" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="28" value="on_direction_changed(): SAME task context&#xa;Both branches: bt_app_task_shut_down()&#xa;Deletes BtAppTask + drains / deletes its queue&#xa;Then audio_codec_sw_reset(); return" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="610" y="1030" width="490" height="145" as="geometry" />
        </mxCell>
        <mxCell id="29" value="direct call" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" parent="1" source="20" target="28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="30" value="BTC_TASK P19&#xa;esp_a2d_register_callback → source bt_app_a2d_cb&#xa;or sink bt_app_a2dp_cb&#xa;&#xa;esp_a2d_sink_register_audio_data_callback&#xa;→ sbc_sink_receive&#xa;&#xa;esp_avrc_ct_register_callback → bt_app_rc_ct_cb&#xa;&#xa;esp_bt_gap_register_callback → bt_app_gap_cb" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1290" y="225" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Timer service P1&#xa;xTimerCreate(..., bt_app_a2d_heart_beat)&#xa;→ invokes function at each connTmr expiry&#xa;No new task per timer / expiry." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1290" y="590" width="450" height="155" as="geometry" />
        </mxCell>
        <mxCell id="32" value="I2S driver / DMA interrupts&#xa;Driver manages ISR + DMA queues internally.&#xa;Application registers no I2S event callback.&#xa;Read / write APIs block and resume in their&#xa;calling RX / TX tasks." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1290" y="800" width="450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="33" value="Still active after current direction callback:&#xa;Bluetooth profiles / stack, heartbeat timer,&#xa;AAC or SBC worker, I2S task + buffers.&#xa;No replacement-mode startup yet.&#xa;RX shutdown TBD; TX mutex cleanup missing." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="1290" y="1030" width="450" height="190" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Saved input polarity is inconsistent:&#xa;is_direction_j2b() returns input == 1,&#xa;but interrupt_task maps input high to B2J.&#xa;No debounce or switching guard exists." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="45" y="1000" width="365" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="7" name="7 | Source references and scope">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1450" pageScale="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="7 | Source references and scope&#xa;Use these paths to connect diagram nodes to code. This is a static source snapshot, not a runtime trace; failure paths are summarized where shown." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1740" height="85" as="geometry" />
        </mxCell>
        <mxCell id="3" value="READING KEY: solid = execution / data transfer • dashed blue = creation / registration • amber = wait • green = queue / buffer • red = limitation&#xa;Priorities: larger number = higher priority. Badges are base priorities (mutex inheritance can raise them). Repeated task lanes refer to the SAME task." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="25" y="1330" width="1740" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="APPLICATION: software/jack2bluetooth/main/drivers/&#xa;&#xa;bt_app_core.c — bt_app_init, work dispatch, BtAppTask loop and teardown&#xa;bt_app_a2dp_sink.c — sink start, callback registration, sink control handler&#xa;sbc_sink.c — decoder creation, packet callback, decode loop, generation gate&#xa;i2s.c — RX/TX creation, PCM stream, ring buffer, semaphore, mutex, DMA I/O&#xa;bt_app_a2dp_source.c — source start, AVRCP/A2DP registration, heartbeat, media state machine&#xa;decode_task.c — AAC creation, PCM frame fill, encoding, MTU check, retries, stop&#xa;bt_app_gap.c — GAP registration, discovery filter, connection and pairing&#xa;io_expander.c — GPIO ISR, notification task, input dispatch&#xa;button.c — current direction callback and button logging&#xa;../main.c — shared initialization and initial RX/TX mode selection" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="1640" height="410" as="geometry" />
        </mxCell>
        <mxCell id="5" value="PRIORITY / SDK EVIDENCE: installed /Users/Paul/.espressif/v6.1/esp-idf/&#xa;&#xa;components/freertos/config/include/freertos/FreeRTOSConfig.h: configMAX_PRIORITIES = 25&#xa;Project sdkconfig: CONFIG_FREERTOS_TIMER_TASK_PRIORITY = 1; CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y&#xa;components/bt/common/btc/core/btc_task.c: BTC_TASK_PRIO = BT_TASK_MAX_PRIORITIES − 6&#xa;components/bt/common/include/bt_common.h: BT_TASK_MAX_PRIORITIES = configMAX_PRIORITIES&#xa;components/bt/host/bluedroid/btc/profile/std/a2dp/btc_a2dp_sink_ext_coedc.c:&#xa;external-codec sink binds data-ready event to current BTC thread, creates audio_rx_q, caps it at 25 packets, invokes audio callback&#xa;&#xa;Official A2DP API reference:&#xa;https://docs.espressif.com/projects/esp-idf/en/stable/esp32/api-reference/bluetooth/esp_a2dp.html" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="1640" height="370" as="geometry" />
        </mxCell>
        <mxCell id="6" value="SCOPE / TIMING&#xa;Application resource creation and task loops are explicit. Bluetooth controller / BTU protocol processing and I2S DMA internals are abstracted.&#xa;Callbacks execute synchronously in their caller task until return. Only posting a queue / event / notification crosses the task boundary.&#xa;portMAX_DELAY means an indefinite FreeRTOS wait where shown; I2S write passes that constant to its driver timeout argument.&#xa;Task priorities describe scheduling, not a guaranteed execution sequence. Operations on different tasks can overlap across cores.&#xa;Nothing in this diagram adds the missing shutdown logic to firmware." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#c9a33b;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="1060" width="1640" height="215" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
