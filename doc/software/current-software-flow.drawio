        <mxCell id="9" value="encode_task_stream_task • 4096 B" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;spacing=2;fontSize=12;" vertex="1" parent="1">
