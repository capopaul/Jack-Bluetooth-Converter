          <mxGeometry x="610" y="590" width="490" height="95" as="geometry" />
        </mxCell>
        <mxCell id="21" value="If INT LOW: vTaskDelay(1 tick), reread&#xa;If INT HIGH: return to notification wait" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" parent="1" vertex="1">
