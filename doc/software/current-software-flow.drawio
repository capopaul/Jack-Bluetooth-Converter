        <mxCell id="18" value="Outer for (;;)&#xa;ulTaskNotifyTake(pdTRUE, portMAX_DELAY)&#xa;BLOCK until notification" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="610" y="220" width="490" height="95" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Inner do / while INT remains LOW&#xa;Read INTF, then GPIO over I2C&#xa;Update cached input_state" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" parent="1" vertex="1">
