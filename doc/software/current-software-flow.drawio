        <mxCell id="27" value="A2DP event → bt_app_a2d_cb()&#xa;INIT_SUCCESS: register AAC + SBC endpoints&#xa;Then enqueue bt_app_av_sm_hdlr message" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=9;" parent="1" vertex="1">
