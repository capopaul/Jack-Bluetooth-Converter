        <mxCell id="25" value="PCM16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" edge="1" parent="1" source="16" target="24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Open encoder; query frame sizes&#xa;Allocate PCM + AAC output buffers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="750" y="220" width="510" height="95" as="geometry" />
        </mxCell>
        <mxCell id="27" value="while (s_stream_run)&#xa;Inner loop: fill one complete PCM frame&#xa;xStreamBufferReceive(..., 100 ms)&#xa;Repeat until full or stop flag" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="750" y="385" width="510" height="95" as="geometry" />
        </mxCell>
        <mxCell id="28" value="esp_audio_enc_process()&#xa;Error / zero output → next frame&#xa;Encoded bytes &gt; MTU − 20 → drop" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="750" y="550" width="510" height="95" as="geometry" />
        </mxCell>
        <mxCell id="29" value="Allocate audio buffer; copy AAC&#xa;Set number_frame=1 + timestamp&#xa;Send retry loop: max 10 attempts while running" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="750" y="715" width="510" height="95" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Success → stack owns buffer; advance timestamp&#xa;Failure → free buffer; invalid state → exit&#xa;Other failures → next frame" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="750" y="880" width="510" height="95" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Normal exit: free PCM / AAC; close encoder&#xa;Clear task handle / running flag&#xa;vTaskDelete(NULL)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="750" y="1045" width="510" height="95" as="geometry" />
