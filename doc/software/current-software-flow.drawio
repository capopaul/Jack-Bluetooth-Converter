        <mxCell id="11" value="P —" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;fontStyle=1;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1675" y="128" width="85" height="32" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Functions / resources here are not tasks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;spacing=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="166" width="300" height="36" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Created by i2s_driver_install(RX)&#xa;Create pcm_stream(8192, trigger=1) first&#xa;Allocate samples + PCM heap buffers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="415" height="95" as="geometry" />
        </mxCell>
        <mxCell id="14" value="while (1)&#xa;i2s_channel_read(..., 1000 ms)&#xa;BLOCK waiting for DMA data / timeout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="50" y="395" width="415" height="95" as="geometry" />
        </mxCell>
        <mxCell id="15" value="ESP_OK / TIMEOUT: use partial data&#xa;Extract upper 16 bits; preserve L/R order" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="415" height="95" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Even sample count + stream has enough space?&#xa;xStreamBufferSend(..., 0)&#xa;Otherwise discard this capture chunk" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="50" y="745" width="415" height="95" as="geometry" />
        </mxCell>
        <mxCell id="17" value="Read error → log + vTaskDelay(10 ms)&#xa;Successful reads return directly to read loop" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="50" y="920" width="415" height="95" as="geometry" />
