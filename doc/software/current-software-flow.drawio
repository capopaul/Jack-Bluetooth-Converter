          </mxGeometry>
        </mxCell>
        <mxCell id="24" value="pcm_stream&#xa;8192 bytes&#xa;One producer: RX&#xa;One consumer: AAC" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#619766;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="525" y="560" width="170" height="150" as="geometry" />
