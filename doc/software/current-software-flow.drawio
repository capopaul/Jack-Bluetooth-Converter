        <mxCell id="4" value="i2s_rx_task" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;verticalAlign=top;align=left;fontStyle=1;spacingTop=14;fillColor=#faf8fc;" vertex="1" parent="1">
