  <diagram id="4" name="4 | Source startup, callbacks and conditional task launch">
    <mxGraphModel dx="2066" dy="1121" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="4 | Source startup, callbacks and conditional task launch&#xa;Source start itself creates no worker: it queues setup. The AAC task is created only after successful media START acknowledgement and an AAC config." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="25" y="15" width="1740" height="85" as="geometry" />
        </mxCell>
        <mxCell id="3" value="READING KEY: solid = execution / data transfer • dashed blue = creation / registration • amber = wait • green = queue / buffer • red = limitation&#xa;Priorities: larger number = higher priority. Badges are base priorities (mutex inheritance can raise them). Repeated task lanes refer to the SAME task." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8effa;strokeColor=#6484ac;fontSize=14;spacing=9;" parent="1" vertex="1">
          <mxGeometry x="25" y="1330" width="1740" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="BTC_TASK / registered callbacks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;verticalAlign=top;align=left;fontStyle=1;spacingTop=14;fillColor=#faf8fc;" parent="1" vertex="1">
