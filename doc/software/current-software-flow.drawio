        <mxCell id="6" value="task__i2s_rx • 4096 B" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee7f5;strokeColor=#9673a6;fontSize=14;spacing=9;spacing=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="35" y="166" width="450" height="36" as="geometry" />
