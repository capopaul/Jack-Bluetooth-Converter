        <mxCell id="42" value="creates / starts timer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;dashed=1;strokeColor=#4477bb;" parent="1" source="15" target="39" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="43" value="repeat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;labelBackgroundColor=#ffffff;fontSize=12;" parent="1" source="40" target="39" edge="1">
